//   Auteur [label="{Auteur|- nom : String\l}"];
//   Membre [label="{Membre|- nom : String\l- maxLivres : Integer\l}"];
//   Bibliotheque [label="{Bibliotheque|- nom : String\l|+ ajouterLivre(l : Livre)\l}"];

//   // Énumération : stéréotype entre \<\< \>\>
//   Statut [label="{\<\<enumeration\>\>\nStatut|LIBRE\lEMPRUNTE\l}"];

//   Roman -> Livre [arrowhead=empty];                                  // héritage
//   Livre -> Bibliotheque [arrowhead=diamond, taillabel="0..*"];       // composition
//   Livre -> Auteur [arrowhead=none, taillabel="0..*", headlabel="1..*", label="écrit par"];
//   Livre -> Membre [arrowhead=none, taillabel="0..*", headlabel="0..1", label="emprunté par"];
//   Livre -> Statut [style=dashed, arrowhead=open];                    // dépendance

  subgraph cluster_modele {                                          // paquetage
    label="paquetage modele"; style=rounded;
    Degree; Type;
  }
}