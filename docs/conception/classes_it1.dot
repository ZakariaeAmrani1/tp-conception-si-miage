// Diagramme de classes : itération 1 (US-01 à US-04)
digraph classes_it1 {
  rankdir=BT;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  Offre [label="{Offre|- anneeSelectionnee : Integer\l|+ creerDiplome(nom : String, typeNom : String, nbEtudiantsMax : Integer)\l+ selectionnerDiplome(nom : String)\l+ selectionnerAnnee(annee : Integer)\l+ trouverDiplome(nom : String) : Diplome\l}"];

  Diplome [label="{Diplome|- nom : String\l- type: TypeDiplome\l- nbEtudiantsMax : Integer\l- /nbAnnees : Integer\l- /nbEcts : Integer\l}"];

  TypeDiplome [label="{TypeDiplome|- nom : String\l- nbAnnees : Integer\l}"];

  // Composition : l'Offre possède ses diplômes (losange côté Offre)
  Diplome -> Offre [arrowhead=diamond, taillabel="0..*", headlabel="1", label="diplomes"];

  // Composition : l'Offre possède les types de diplôme
  TypeDiplome -> Offre [arrowhead=diamond, taillabel="1..*", headlabel="1", label="types"];

  // Association navigable : le diplôme sélectionné (aucun ou un)
  Offre -> Diplome [arrowhead=vee, headlabel="0..1", label="selection"];

  // Association navigable : un diplôme a exactement un type
  Diplome -> TypeDiplome [arrowhead=vee, taillabel="0..*", headlabel="1", label="type"];
}