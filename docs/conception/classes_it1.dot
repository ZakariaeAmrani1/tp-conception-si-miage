digraph offreDeFormation {
  rankdir=BT;
  node [shape=record, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];

  Degree [label="{Degree|- name : String\l- type : Type\l- nbStudents : Integer\l- nbECTS : Integer\l|+ getName() : String\l+ getType() : String\l}"];
  Type [label="{Type|- name : String\l- nbYears : Integer\l|+ getName() : String\l+ getNbYears() : Integer\l}"];

  Degree -> Type [arrowhead=none, taillabel="1", headlabel="0..*", label="est de type"];













